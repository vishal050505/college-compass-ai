generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model College {
  id              Int      @id @default(autoincrement())
  name            String
  location        String
  state           String
  fees            Int
  rating          Float
  avgPackage      Float
  highestPackage  Float
  placementRate   Float
  establishedYear Int
  description     String
  image           String
  type            String
  rank            Int
  totalStudents   Int
  acceptedExams   String[]
  minRank         Int
  maxRank         Int

  courses         Course[]
  reviews         Review[]

  createdAt       DateTime @default(now())
}

model Course {
  id          Int      @id @default(autoincrement())
  courseName  String
  duration    String
  fees        Int
  seats       Int

  collegeId   Int
  college     College  @relation(fields: [collegeId], references: [id])

  createdAt   DateTime @default(now())
}

model Review {
  id          Int      @id @default(autoincrement())
  studentName String
  batch       String
  rating      Float
  comment     String

  collegeId   Int
  college     College  @relation(fields: [collegeId], references: [id])

  createdAt   DateTime @default(now())
}